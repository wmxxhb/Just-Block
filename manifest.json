{
  "manifest_version": 3,
  "name": "Just Block",
  "description": "屏蔽指定网站，回答问题、手打文字并等待后临时访问。",
  "version": "1.3.2",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Just Block",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "gate.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "incognito": "not_allowed",
  "key": ""
}
